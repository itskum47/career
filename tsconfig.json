{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "declaration": false,
    "verbatimModuleSyntax": false,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@job-agent/*": [
        "src/*"
      ],
      "@apps/*": [
        "apps/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "apps",
    "tests",
    "types"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "applications",
    "logs",
    "data"
  ]
}