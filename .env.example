# === LLM PROVIDER ===
# Custom Anthropic-compatible endpoint already configured in the environment
# (ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL). Override here if needed.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o
# Generic fallback (used when none of the above are set):
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# === DATABASE ===
# sqlite (default, zero-config) | postgres
DB_DRIVER=sqlite
DB_PATH=./data/job-agent.db
DATABASE_URL=
DB_POOL_MIN=2
DB_POOL_MAX=10

# === REDIS ===
REDIS_URL=redis://127.0.0.1:6379
USE_REDIS=false

# === BROWSER ===
# Backend: playwright (default, Chromium) | obscura (lightweight Rust browser, CDP)
BROWSER_BACKEND=playwright
OBSCURA_BIN=obscura
OBSCURA_PORT=9222
OBSCURA_STEALTH=false
BROWSER_PROFILE_PATH=~/.job-agent/browser-profile
BROWSER_HEADLESS=true
BROWSER_SLOW_MO=50

# === APPLICATION POLICY ===
AUTO_SUBMIT=false
MAX_JOBS_DISCOVERED=200
MAX_APPLICATIONS_PER_DAY=25
MAX_BROWSER_CONCURRENCY=2
MAX_RESUME_REVISIONS=3
MATCH_THRESHOLD=60
ATS_THRESHOLD=70

# === SCHEDULING ===
SCHEDULE_DAILY=true
SCHEDULE_TIME=09:00

# === OBSERVABILITY ===
LOG_LEVEL=info
LOG_DIR=./logs

# === DESKTOP OUTPUTS ===
DESKTOP_PATH=~/Desktop
CV_OUTPUT_DIR=~/Desktop/cv
EXCEL_PATH=~/Desktop/job-applications.xlsx

# === TESTING ===
# Set to 1 to use deterministic mock LLM responses (no network, no API key needed)
# Default ON so first run is free; set to 0 once you add an API key.
MOCK_LLM=1