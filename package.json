{
  "name": "job-agent",
  "version": "1.0.0",
  "description": "Autonomous multi-agent job application platform",
  "type": "module",
  "main": "apps/orchestrator/src/index.ts",
  "bin": {
    "job-agent": "apps/orchestrator/src/cli.ts"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "browser:install-obscura": "bash scripts/install-obscura.sh",
    "agent": "tsx apps/orchestrator/src/cli.ts run",
    "agent:discover": "tsx apps/orchestrator/src/cli.ts discover",
    "agent:apply": "tsx apps/orchestrator/src/cli.ts apply",
    "agent:dashboard": "tsx apps/dashboard/src/dev-server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:e2e": "tsx tests/e2e/run-fake-ats.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "performance:report": "tsx scripts/performance-report.ts",
    "chat": "tsx scripts/chat-control.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "pg": "^8.13.0",
    "redis": "^4.7.0",
    "playwright": "^1.63.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.20.2",
    "yaml": "^2.5.1",
    "zod": "^3.23.8",
    "fastify": "^5.1.0",
    "p-limit": "^6.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.14.0",
    "commander": "^12.1.0",
    "node-cron": "^3.0.1",
    "glob": "^10.4.5",
    "jsdom": "^25.0.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}